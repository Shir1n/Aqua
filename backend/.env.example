# Copia este archivo como backend/.env y completa tus propios valores.
# backend/.env está ignorado por git: nunca subas credenciales reales.

# Puerto de la API (el frontend y el formulario esperan 3001).
PORT=3001

# Correo SMTP: necesario para enviar el código de verificación del registro.
# Gmail: activa la verificación en dos pasos y usa una contraseña de aplicación.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASSWORD=contraseña-de-aplicacion
SMTP_FROM="SIGMA-Aqua <tu-cuenta@gmail.com>"
